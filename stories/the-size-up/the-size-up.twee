/* The Size-Up: an interactive story about "What's really going on?"
   My Strategy Squad. Marisol, Keith and the cafe are invented.
   Written with Claude, an AI assistant, and edited and tested by Andrew David Roberts.
   Text: CC BY 4.0. The My Strategy Squad name, the knight logo and the symbols are not covered. */
<<newstory>>

:: StoryCaption
<<if def $notebook and passage() isnot "Start">>\
<span class="cap-label">Hours left</span>
<span class="cap-hours"><<= $hours>> of 20</span>
<span class="cap-label">Day</span>
<span class="cap-day"><<if tags().includes("friday")>>Friday<<elseif tags().includes("thursday")>>Thursday<<elseif tags().includes("wednesday")>>Wednesday<<else>><<= setup.day($hours)>><</if>></span>
<span class="cap-label">Notebook</span>
<<link "Read it (<<= $notebook.length>>)">><<run Dialog.create("Marisol's notebook").wikiPassage("Notebook").open()>><</link>>
<</if>>

:: StoryScript [script]
/* Which day it is, from the hours left. The meeting is Friday morning. */
setup.day = function (h) {
  if (h > 14) { return "Monday"; }
  if (h > 8) { return "Tuesday"; }
  if (h > 2) { return "Wednesday"; }
  return "Thursday";
};
/* The four stories a player can write on Wednesday evening. */
setup.storyName = {
  chain: "The new chain café is stealing customers",
  prices: "The prices are too high",
  welcome: "The welcome has slipped on Saturdays",
  location: "People aren't passing the door anymore"
};
/* What in the notebook supports or cuts against each story. Only places the player looked count. */
setup.evidence = function (story, seen, cart) {
  var has = function (p) { return seen.indexOf(p) !== -1; };
  var f = [], a = [];
  if (story === "chain") {
    if (has("Florist")) { f.push({ text: "The florist says everyone's going there.", tag: "rumor" }); }
    if (has("Chain")) { a.push({ text: "Its crowd is mostly students and laptops, not Marisol's commuters.", tag: "fact" }); }
    if (has("Till")) { a.push({ text: "Weekdays are steady. A rival would take weekday trade too.", tag: "fact" }); }
  } else if (story === "prices") {
    if (has("Prices")) { f.push({ text: "Prices did go up, by 30 cents.", tag: "fact" }); a.push({ text: "Sales held for months after the rise. The drop started three weeks ago.", tag: "fact" }); }
    if (has("Till")) { a.push({ text: "Weekdays, at the same prices, are steady.", tag: "fact" }); }
  } else if (story === "welcome") {
    if (has("Staff")) { f.push({ text: "Ana says Saturdays feel flat, and people chat less.", tag: "opinion" }); }
    if (has("Till")) { a.push({ text: "The drop is a third of Saturday trade, and it started suddenly. That's a lot for one quiet barista.", tag: "fact" }); }
  } else if (story === "location") {
    if (has("Station")) { f.push({ text: "The station exit onto Marisol's street has been closed for three weeks.", tag: "fact" }); }
    if (has("Corner")) { f.push({ text: "Almost nobody walked down the street from the station at rush hour.", tag: "fact" }); }
    if (has("Regulars")) { f.push({ text: "A regular now walks \"the long way round\" from the station.", tag: "fact" }); }
    if (has("Till")) { f.push({ text: "The drop is Saturday mornings, when the market crowd arrives by train.", tag: "fact" }); }
  }
  if (cart && (story === "location" || story === "chain")) {
    (story === "location" ? f : a).push({ text: "At the west exit cart, Marisol's missing customers turned up. They couldn't find her.", tag: "fact" });
  }
  return { supports: f, against: a };
};
/* Each place you can look: hours it costs. */
setup.cost = {
  "Till": 3, "Regulars": 4, "Chain": 4, "Corner": 4,
  "Staff": 2, "Florist": 2, "Prices": 2, "Station": 3
};

:: StoryWidgets [widget]
<<widget "newstory">>\
<<set $hours to 20>><<set $notebook to []>><<set $seen to []>><<set $sizeup to 0>><<set $stories to []>><<set $tested to false>><<set $working to "">><<set $test to "">><<set $cart to false>><<set $plan to "">>\
<</widget>>

<<widget "clue">>\
<<set $notebook.push({ text: _args[0], tag: _args[1] })>>\
<<if _args[1] is "fact">><<set $sizeup += 1>><</if>>\
<div class="clue"><span @class="'tag tag-' + _args[1]"><<= _args[1]>></span> Added to the notebook: <<= _args[0]>></div>\
<</widget>>

<<widget "spend">>\
<<set $hours -= _args[0]>><<set $seen.push(_args[1])>>\
<</widget>>

:: StoryStylesheet [stylesheet]
@import url("https://use.typekit.net/wyx7llq.css");
@import url("../../assets/mss.css");
/* Colors and fonts come from assets/mss.css. */
body { background: var(--bg); color: var(--ink); font-family: var(--font-body); font-weight: 300; font-size: 18px; line-height: 1.5; }
#story { margin-left: 18em; }
#ui-bar { background: var(--panel); border-right: 4px solid var(--ink); color: var(--ink); }
#ui-bar a, #story a, .macro-link { color: var(--blue); }
#story a:hover, .macro-link:hover { color: var(--mss-purple); text-decoration: none; }
#passages { max-width: 38rem; }
.passage { border: 4px solid var(--ink); background: var(--panel); padding: 16px 20px; }
h1, h2, h3 { color: var(--gold); font-family: inherit; }
h1, h2 { font-family: var(--font-title); font-weight: 600; font-variant-ligatures: none; }
/* MSS signature: the blue-to-purple gradient (Andrew, October 24, 2026). Large headings only. */
h1, h2 { background: linear-gradient(90deg, var(--mss-blue), var(--mss-purple)); -webkit-background-clip: text; background-clip: text; color: transparent; display: table; }
h1::after { content: ""; display: block; height: 4px; margin-top: 6px; background: linear-gradient(90deg, var(--mss-blue), var(--mss-purple)); }
.cap-label { display:block; color: var(--dim); font-size: .8rem; margin-top: .8em; text-transform: uppercase; letter-spacing: .05em; }
.cap-hours { display:block; color: var(--gold); font-size: 1.2rem; }
.cap-day { display:block; color: var(--mss-purple); font-size: 1.2rem; }
.speech { border-left: 4px solid var(--orange); padding-left: 10px; margin: 10px 0; }
.clue { border: 2px dashed var(--blue); padding: 8px 10px; margin: 12px 0; font-size: .95rem; }
.tag { display:inline-block; padding: 0 6px; margin-right: 6px; font-size: .8rem; text-transform: uppercase; color: var(--bg); }
.tag-fact { background: var(--good); }
.tag-opinion { background: var(--gold); }
.tag-rumor { background: var(--bad); }
.choices { margin-top: 1.2em; }
.choices li { margin: .4em 0; }
.done { color: var(--dim); text-decoration: line-through; }
.greyed { color: var(--dim); }
.box { border: 2px solid var(--mss-purple); padding: 10px 12px; margin: 12px 0; }
#ui-dialog { background: var(--panel); border: 4px solid var(--ink); color: var(--ink); }
#ui-dialog-titlebar { background: var(--bg); border-bottom: 2px solid var(--ink); }
#ui-dialog-title { color: var(--mss-purple); font-family: var(--font-head); }
#ui-dialog-close { color: var(--ink); }
#ui-dialog-body { background: var(--panel); font-family: var(--font-head); }
#ui-dialog-body .tag-fact, .passage .tag-fact { background: var(--good) !important; color: var(--bg) !important; }
#ui-dialog-body .tag-opinion, .passage .tag-opinion { background: var(--gold) !important; color: var(--bg) !important; }
#ui-dialog-body .tag-rumor, .passage .tag-rumor { background: var(--bad) !important; color: var(--bg) !important; }
#ui-bar-body { color: var(--ink); }
@media screen and (max-width: 768px) { #story { margin-left: 0; } body { font-size: 17px; } }

:: Start
<h1>The Size-Up</h1>\
<p class="speech">Saturday takings at Marisol's café are down by a third. Three weeks running.</p>\
Marisol slides the till printout across the counter. Behind her, Keith, the new weekend barista, is polishing a cup that is already very clean.

"On Friday I meet the landlord about renewing the lease," she says. "He'll ask how business is. And you never know with him. He could double the rent. Triple it."

She taps the printout.

<p class="speech">"It's that new chain place, two streets over. It has to be. So what do we do: cut prices, or a loyalty card, or both?"</p>\
You're her squad. You have until Friday morning.

<ul class="choices">
<li>[[Agree. Start planning the fight back.|Fight back]]</li>
<li>[[“Maybe. Let's find out what's really going on first.”|The notebook]]</li>
</ul>

:: Fight back [friday]
<h2>Friday</h2>\
You and Marisol spend the week on a price cut and a loyalty card. Coffee drops by 50 cents. The cards are lovely: a little gold knight on each one.

Saturdays stay flat.

Worse, now every cup earns less, so the weekdays that were fine are thinner too. When the landlord asks how business is, Marisol says "competitive," and he hears "struggling." It's not a great week to be negotiating a lease.

The chain café two streets over never notices any of this.

<div class="box">\
<b>Ending: Price war.</b> You picked the loudest explanation and acted on it straight away. The trouble is, nobody checked whether it was true.

Want to see what was really going on? There's a different story hiding in this café.
</div>\
[[Debrief|Debrief]]

:: The notebook
"Fine," says Marisol, and hands you a battered notebook. "Write it all down, then. I'll keep making flat whites."

<div class="box">\
<b>How this works</b>

You have <b>20 hours</b> between now and Friday morning. Marisol still has a café to run, so that's all the time there is. Looking everywhere would take 24.

Every place you look costs hours. You won't have time to look everywhere, so choose.

Everything you learn goes in the <b>notebook</b>, with a label:

* <span class="tag tag-fact">fact</span> something you saw or counted yourself.
* <span class="tag tag-opinion">opinion</span> what someone thinks, which may or may not be right.
* <span class="tag tag-rumor">rumor</span> what someone heard, or guessed, about somebody else.

You can reread the notebook any time from the sidebar. (On a phone, it's under the menu button.)
</div>\
[[Let's start looking.|Look around]]

:: Look around
<h2>Where do you look?</h2>\
<<if $seen.length is 0>>Where would you start, if it were your café? There isn't time to look everywhere.<<else>>You have <b><<= $hours>> hours</b> left. Where next?<</if>>

<span class="greyed">Tip: keep a few hours in hand. On Thursday you'll want time to test your best idea.</span>

<ul class="choices">
<<for _p range ["Till", "Regulars", "Chain", "Corner", "Staff", "Florist", "Prices", "Station"]>>\
<<set _label to {
  "Till": "Go through the till data, day by day and hour by hour",
  "Regulars": "Chat with three regulars",
  "Chain": "Visit the new chain café",
  "Corner": "Stand on the corner at 8 a.m. and count who walks by",
  "Staff": "Ask the staff what they think",
  "Florist": "Talk to the neighbor at the flower stall",
  "Prices": "Compare this year's prices with last year's",
  "Station": "Walk to the station"
}[_p]>>\
<<set _cost to setup.cost[_p]>>\
<<if $seen.includes(_p)>><li class="done"><<= _label>></li>\
<<elseif _cost > $hours>><li class="greyed"><<= _label>> (<<= _cost>> hours: not enough time)</li>\
<<else>><li><<link `_label + " (" + _cost + (_cost is 1 ? " hour)" : " hours)")` `"Look: " + _p`>><</link>></li><</if>>
<</for>>\
</ul>

<<if $notebook.length > 0>><<link "Read the notebook">><<run Dialog.create("Marisol's notebook").wikiPassage("Notebook").open()>><</link>><</if>>

<<if $seen.length > 0>>[[That's enough looking. Time to think.|Wednesday evening]]<</if>>

:: Look: Till
<<spend 3 "Till">>\
<h2>The till data</h2>\
Three hours with a spreadsheet and a lot of coffee.

Weekdays are almost exactly where they were last year. Saturday afternoons are down a little. Saturday <i>mornings</i>, between 7 and 11, have fallen off a cliff.

Whatever is happening, it's happening on Saturday mornings.

"That's the market crowd," says Marisol. "People come in on the train for the Saturday market down the road, and they pass my door on the way. Weekdays it's mostly locals and the office lot. They know where I am."

<<clue "Weekdays are steady. The drop is almost all Saturday mornings, 7 to 11, when the market crowd comes in by train." "fact">>\
[[Back to the notebook|Look around]]

:: Look: Regulars
<<spend 4 "Regulars">>\
<h2>The regulars</h2>\
You catch three regulars over a long morning.

<p class="speech">"Me? I'm in every day. Wouldn't go anywhere else."</p>\
<p class="speech">"The chain place? Tried it once. Coffee tasted like a cardboard box."</p>\
The third, a nurse coming off a night shift, laughs.

<p class="speech">"I still come. It's just a faff now. I have to walk the long way round from the station."</p>\
She doesn't say why, and she's gone before you can ask.

<<clue "The regulars say they're loyal. They would say that, though." "opinion">>\
<<clue "One regular now has to walk \"the long way round\" from the station. Why?" "fact">>\
[[Back to the notebook|Look around]]

:: Look: Chain
<<spend 4 "Chain">>\
<h2>The chain café</h2>\
It's big, bright and busy. You buy a coffee and sit in the corner for an hour, counting.

Most of the customers are students on laptops, settling in for the afternoon. A few look like they might be Marisol's crowd, but only a few. Nobody here is grabbing a coffee on the way to a train.

<<clue "The chain café is busy, but mostly with a different crowd: students and laptops, not commuters." "fact">>\
[[Back to the notebook|Look around]]

:: Look: Corner
<<spend 4 "Corner">>\
<h2>The corner, 8 a.m.</h2>\
You stand on the corner with a clicker counter from the hardware store, at the busiest time of day, and count everyone walking down the street from the direction of the station.

You expect a stream of commuters.

There's a trickle. A man with a dog. A jogger. In an hour, nobody with a train ticket in their hand.

Marisol frowns when you show her the number. "That's odd. It's normally busy at eight."

<<clue "In an hour at rush hour, almost nobody walked down the street from the station." "fact">>\
[[Back to the notebook|Look around]]

:: Look: Staff
<<spend 2 "Staff">>\
<h2>The staff</h2>\
Keith shrugs. "It's just quiet. Saturdays are like that now."

Ana, who has worked Saturdays for two years, is less sure. "It feels flat. People used to chat. I don't know. It's a different feel."

Keith goes back to the cup.

<<clue "Keith thinks Saturdays are \"just quiet.\"" "opinion">>\
<<clue "Ana says Saturdays \"feel flat,\" and people chat less." "opinion">>\
[[Back to the notebook|Look around]]

:: Look: Florist
<<spend 2 "Florist">>\
<h2>The flower stall</h2>\
The florist next door has opinions, and she would like to share all of them.

<p class="speech">"Everyone's going to the chain place, love. Bet they're cheaper. My cousin says they're giving away free muffins. Or was it free WiFi? Something free."</p>\
<<clue "\"Everyone's going to the chain place.\" (The florist's cousin says so.)" "rumor">>\
[[Back to the notebook|Look around]]

:: Look: Prices
<<spend 2 "Prices">>\
<h2>The prices</h2>\
Marisol raised her prices by 30 cents in the spring. You check the sales either side of the change.

Weekday sales didn't budge. Neither did Saturdays, for months afterward. The drop only started three weeks ago.

<<clue "Prices went up in the spring, but sales held for months. The drop started three weeks ago." "fact">>\
[[Back to the notebook|Look around]]

:: Look: Station
<<spend 3 "Station">>\
<h2>The station</h2>\
It's a five-minute walk. Or it used to be.

The station's east exit, the one that opens onto Marisol's street, is behind a blue fence. A sign on the fence says <i>Repair works. Please use the west exit. We apologize for any inconvenience.</i> A notice taped below it gives a date. About six weeks from now.

You walk out of the west exit and look around. From here, Marisol's café is out of sight, round two corners. The chain café is right in front of you.

<<set $sizeup += 2>>\
<<clue "The station's east exit, onto Marisol's street, has been closed for about three weeks. It reopens in about six weeks." "fact">>\
[[Back to the notebook|Look around]]

:: Wednesday evening [wednesday]
<h2>Wednesday evening</h2>\
The café is closed. Marisol puts two cups of tea on the table, and you open the notebook.

<<if $notebook.length is 0>>\
It's empty. Marisol raises an eyebrow. "So we're guessing, then."
<<else>>\
You found <b><<= $notebook.length>></b> <<= $notebook.length is 1 ? "clue" : "clues">>:

<<include "Notebook">>\
<</if>>

<div class="box">\
<b>Step two of the Size-Up: write three stories.</b> Don't pick an answer yet. Write down three different explanations that could fit what you've seen, and then see which one the notebook backs.
</div>\
<<if $seen.includes("Station") or $seen.includes("Corner") or $seen.includes("Regulars")>>\
Looking at the notebook, you can think of four stories. There's room for three on the page. Which one do you leave out?

<ul class="choices">
<<for _k range ["chain", "prices", "welcome", "location"]>>\
<li><<capture _k>><<link `"Leave out: " + setup.storyName[_k]` "Weigh the stories">><<set $stories to ["chain", "prices", "welcome", "location"].filter(function (x) { return x !== _k; })>><</link>><</capture>></li>
<</for>>\
</ul>
<<else>>\
Your notebook gives you three stories:

<ul>
<li>The new chain café is stealing customers.</li>
<li>The prices are too high.</li>
<li>The welcome has slipped on Saturdays.</li>
</ul>
<span class="greyed">Keep a little belief in your pocket for a story you haven't thought of yet.</span>

<<link "Write them down" "Weigh the stories">><<set $stories to ["chain", "prices", "welcome"]>><</link>>
<</if>>

:: Weigh the stories [wednesday]
<h2>What backs each story?</h2>\
For each story, here's what's in the notebook for it, and against it. A story is only as strong as its weakest link.

<<for _st range $stories>>\
<<set _ev to setup.evidence(_st, $seen, $cart)>>\
<div class="box">\
<b><<= setup.storyName[_st]>></b>
<span class="cap-label">For</span>\
<<if _ev.supports.length is 0>><span class="greyed">Nothing in the notebook yet.</span><<else>><<for _c range _ev.supports>><div class="clue"><span @class="'tag tag-' + _c.tag"><<= _c.tag>></span> <<= _c.text>></div><</for>><</if>>
<span class="cap-label">Against</span>\
<<if _ev.against.length is 0>><span class="greyed">Nothing in the notebook cuts against it.</span><<else>><<for _c range _ev.against>><div class="clue"><span @class="'tag tag-' + _c.tag"><<= _c.tag>></span> <<= _c.text>></div><</for>><</if>>
</div>\
<</for>>\
Which story do you work with? You can change your mind later. That's the point.

<ul class="choices">
<<for _st range $stories>>\
<li><<capture _st>><<link `setup.storyName[_st]` "Weakest link">><<set $working to _st>><<if _st is "location">><<set $sizeup += 2>><</if>><<if setup.evidence(_st, $seen, false).supports.some(function (c) { return c.tag === "fact"; })>><<set $sizeup += 1>><</if>><</link>><</capture>></li>
<</for>>\
</ul>

:: Weakest link [wednesday]
<h2>The weakest link</h2>\
Your working story: <b><<= setup.storyName[$working]>></b>.

<<if $working is "location">>\
You know fewer people are walking past the door. What you don't know is whether the missing customers still want Marisol's coffee. Maybe they've just given up coffee.

<div class="box"><b>Cheapest check:</b> run a coffee cart at the station's west exit for one morning, and see who turns up.</div>\
<<elseif $working is "chain">>\
Is anyone actually leaving Marisol for the chain? <<if $seen.includes("Florist")>>So far you have the florist's cousin's word for it.<<else>>So far, nobody has said so.<</if>>

<div class="box"><b>Cheapest check:</b> the chain is right outside the station's west exit. Run a coffee cart there for one morning. If Marisol's crowd is going to the chain, they'll walk straight past her cart.</div>\
<<elseif $working is "prices">>\
If price is the problem, then cheaper coffee should bring people back. Would it?

<div class="box"><b>Cheapest check:</b> put last year's prices back for one day, and compare the takings with last week.</div>\
<<else>>\
If the welcome is the problem, it should show when someone walks in. Does it?

<div class="box"><b>Cheapest check:</b> ask a friend to come in as a mystery customer and tell you honestly how it felt.</div>\
<</if>>\
<span class="greyed">And keep a little belief in your pocket for the story you haven't thought of yet.</span>

[[On to Thursday|Thursday]]

:: Thursday [thursday]
<h2>Thursday</h2>\
The last day before the meeting. You have <b><<= $hours>> <<= $hours is 1 ? "hour" : "hours">></b> left. A test takes 2.

<<if $hours < 2>>\
You spent all your hours looking. There's no time left to test anything. Lots of clues and no time to check them is a common way to run out of road.

[[On to Friday|Friday]]
<<else>>\
<ul class="choices">
<li>[[Run a coffee cart at the station's west exit, 7 to 10 a.m.|Test: Cart]]</li>
<li>[[Ask a friend to come in as a mystery customer|Test: Mystery]]</li>
<li>[[Put last year's prices back for the day|Test: Prices]]</li>
<li>[[Skip the test. Go with your gut.|Friday]]</li>
</ul>
<</if>>

:: Test: Cart [thursday]
<<set $hours -= 2>><<set $test to "cart">><<set $cart to true>>\
<<if $working is "location" or $working is "chain">><<set $tested to true>><<set $sizeup += 2>><<else>><<set $sizeup += 1>><</if>>\
<h2>The cart</h2>\
Marisol borrows a cart from her cousin. You set it up at the west exit at seven.

By half past eight, you're out of milk.

Half the faces in the queue are ones Marisol knows. "Oh! You're the café round the corner," says one man. "We couldn't find you since they shut the other exit. Thought you'd closed."

Nobody mentions the chain café, even though it's right there.

<<clue "At the west exit cart, Marisol's missing customers turned up. They couldn't find her since the exit closed." "fact">>\
<<if $working is "chain">><div class="box">Your working story was the chain. The cart just told you something different. That's what a cheap test is for: finding out before Friday, not after.</div><</if>>\
[[On to Friday|Friday]]

:: Test: Mystery [thursday]
<<set $hours -= 2>><<set $test to "mystery">>\
<<if $working is "welcome">><<set $tested to true>><<set $sizeup += 2>><<else>><<set $sizeup += 1>><</if>>\
<h2>The mystery customer</h2>\
Marisol asks Keith to cover the morning, and your friend Dev comes in at nine.

His report: "Coffee was excellent. The guy behind the counter didn't look up once. Then an older woman, Ana I think, came over and asked how my week was going. Nice place. Bit quiet."

So the welcome has slipped a little when Keith is on his own. But a quiet barista doesn't explain why a third of Saturday mornings vanished, three weeks ago, all at once.

<<clue "Keith is quiet with customers; Ana makes up for it. Worth fixing, but too small to explain the drop." "fact">>\
[[On to Friday|Friday]]

:: Test: Prices [thursday]
<<set $hours -= 2>><<set $test to "prices">>\
<<if $working is "prices">><<set $tested to true>><<set $sizeup += 2>><<else>><<set $sizeup += 1>><</if>>\
<h2>Old prices</h2>\
Marisol writes last year's prices on the board.

At closing, you compare the takings with last Thursday. They're the same, almost to the dollar. Two regulars notice, and one asks if everything's all right.

<<clue "With last year's prices back for a day, takings didn't change." "fact">>\
[[On to Friday|Friday]]

:: Friday [friday]
<h2>Friday morning</h2>\
The meeting with the landlord is at ten. Marisol looks at you over the top of her cup. "Right. What do we do?"

<<set _knowsplace to $seen.includes("Station") or $seen.includes("Corner") or $seen.includes("Regulars") or $cart>>\
<ul class="choices">
<li><<link "Cut prices and fight the chain" "End: Price war">><</link>></li>
<<if _knowsplace>>\
<li><<link "Run the cart at the west exit and put up signs until the works finish. Show the landlord the evidence and the reopening date." "End: Location">><<set $plan to "location">><</link>></li>
<<if $seen.includes("Staff") or $test is "mystery">>\
<li><<link "All of that, and have a quiet word with Keith about the welcome" "End: Location">><<set $plan to "location+">><<set $sizeup += 1>><</link>></li>
<</if>>\
<</if>>\
<li><<link "Coach Keith on the welcome" "End: Wrong thing">><<set $plan to "welcome">><</link>></li>
<li><<link "Put the old prices back" "End: Wrong thing">><<set $plan to "prices">><</link>></li>
<li><<link "Do nothing. Saturday might pick up." "End: Worry">><</link>></li>
</ul>

:: End: Price war [friday]
<h2>Ending: Price war</h2>\
Coffee drops by 50 cents. The new loyalty cards have a little gold knight on each one.

Saturdays stay flat. Every cup now earns less, so the weekdays thin out too. When the landlord asks how business is, Marisol says "competitive," and he hears "struggling."

The chain café two streets over never notices.

<div class="box">\
You blamed the loudest explanation and acted on it. <<if $seen.includes("Station")>>The notebook already held the station clue. The answer was in your hands, and the story you'd already settled on talked over it.<<else>>The real cause never made it into the notebook.<</if>>
</div>\
[[Debrief|Debrief]]

:: End: Location [friday]
<<set _evidence to $seen.includes("Station") or $seen.includes("Corner") or $cart>>\
<<if _evidence and $cart>>\
<h2>Ending: Sized up</h2>\
Marisol walks into the meeting with your notebook and a photo of the queue at the cart.

"Saturday mornings are down because the exit's shut," she says. "It reopens in six weeks. Until then, I'm running a cart where the people are."

The landlord looks at the photo for a long time. He renews for the same rent. Then he asks whether the cart could do mornings in the lobby of his other building.

<div class="box">\
You found facts, wrote more than one story, checked the weakest link cheaply, and acted on what you learned. That's the Size-Up.<<if $plan is "location+">> And you didn't ignore the smaller problem: Keith's having a quiet word with Ana about the welcome.<</if>>
</div>\
<<elseif _evidence>>\
<h2>Ending: Good call, untested</h2>\
Marisol puts up signs at the west exit and runs the cart on Saturday. It works: the market crowd finds her again. She tells the landlord about the exit and the reopening date, and he renews.

<div class="box">\
Your facts pointed the right way, and you acted on them. But you never checked the weakest link: whether the missing customers still wanted Marisol's coffee. This time they did. A two-hour test on Thursday would have turned a good guess into something she could show the landlord.
</div>\
<<else>>\
<h2>Ending: Right answer, wrong reason</h2>\
Marisol runs the cart and puts up signs. Saturdays pick up. She tells the landlord it's "the station, probably," and he renews.

<div class="box">\
It worked out. But all you had was one regular's remark about walking the long way round. Judging a decision by how it turned out is called resulting. Ask yourself: would you bet the café on that reasoning again?
</div>\
<</if>>\
[[Debrief|Debrief]]

:: End: Wrong thing [friday]
<h2>Ending: Fixing the wrong thing</h2>\
<<if $plan is "welcome">>\
Keith gets a pep talk and a name badge. He even smiles at people. It helps a little.
<<else>>\
The old prices go back on the board. A few regulars are pleased.
<</if>>\
Saturday mornings stay a third down. When the landlord asks why, Marisol doesn't really know.

<div class="box">\
You fixed something real, but small. The big drop is still a mystery, and it will stay one for six weeks, until the station exit quietly reopens and nobody knows why things got better.
</div>\
[[Debrief|Debrief]]

:: End: Worry [friday]
<h2>Ending: Nothing but worry</h2>\
Marisol goes into the meeting with nothing but worry. The landlord asks how business is. She says, "Fine." He doesn't believe her, and the new lease comes back with a higher rent.

<div class="box">\
Doing nothing is a choice too. With nothing to show him, Marisol had nothing to bargain with.
</div>\
[[Debrief|Debrief]]

:: Debrief [friday]
<h2>Debrief</h2>\
<<set _facts to $notebook.filter(function (c) { return c.tag === "fact"; }).length>>\
<<set _rumors to $notebook.filter(function (c) { return c.tag === "rumor"; }).length>>\
<<if $notebook.length is 0>>Your notebook was empty.<<else>>Your notebook: <b><<= $notebook.length>></b> <<= $notebook.length is 1 ? "clue" : "clues">>, <b><<= _facts>></b> of them <<= _facts is 1 ? "a fact" : "facts">><<if _rumors > 0>>, and <<= _rumors>> <<= _rumors is 1 ? "rumor" : "rumors">><</if>>.<</if>> <<if $seen.includes("Station")>>You found the station.<<else>>You never walked to the station.<</if>> <<if $test is "">>You didn't test anything.<<elseif $tested>>You tested your working story's weakest link.<<else>>You ran a test, but not on your working story.<</if>>

<ol>
<li>What did you expect?</li>
<li>What actually happened?</li>
<li>Why the gap?</li>
<li>What would you change?</li>
<li>What does this story get wrong about real life?</li>
</ol>
And one for this story: <b>which clue changed your mind, and was it a fact, an opinion or a rumor?</b>

<div class="box">\
<b>Take it home.</b> Next time something goes wrong in your work, try the Size-Up. Say what you see, facts only. Write three stories: the one you reached for, the one you'd rather weren't true, and someone else's. Find each story's weakest link and the cheapest way to check it this week.
</div>\
<span class="greyed">In real life, clues don't arrive neatly labeled, and you rarely get a cart and a mystery customer for two hours each. The thinking still holds.</span>

<span class="greyed">Ideas behind this story: Richard Rumelt on asking "What's going on here?"; John Kay and Mervyn King on puzzles and mysteries, and on reference narratives (<i>Radical Uncertainty</i>, 2020); Kevin Clermont on weighing stories (2020). From the My Strategy Squad podcast, Episodes 5 and 10.</span>

<<link "Play again" "Start">><<newstory>><</link>>

